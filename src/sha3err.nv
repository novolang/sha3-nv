// sha3err — the refusals, and why there are so few of them.
//
// Keccak absorbs any message and squeezes any number of bytes, so
// nothing about the MESSAGE can be wrong, and the SP 800-185 length
// encodings carry every number a novo-lang `Int` can hold.  Every
// refusal in this package is therefore about a LENGTH the caller chose
// or an ORDER the caller used, and the two questions a program asks
// about a failure — "did I size a buffer wrong" and "did I call these
// in the wrong order" — are the two predicates below.
//
// The one refusal that is neither is `Sha3RateNotPositive`, and it
// exists because `sha3sponge.sponge` takes a rate as a number: a rate
// of zero is not a sponge, the function has nowhere to put a refusal,
// and this is the code a caller checks a rate of its own with.

use std.str

// What a call in this package refuses with.
//
// Every arm carries the numbers a message needs, so a report can say
// what was asked for and what was given instead of "invalid
// argument".
pub enum Sha3Error
    // The output buffer is not the length the fixed-width hash
    // produces.  SHA3-256 writes 32 bytes and nothing else, so a
    // buffer of another length is a mistake rather than a truncation
    // request; `sha3xof` is where a caller who wants n bytes goes.
    Sha3OutputBufferWrong(want: Int, got: Int)
    // An output of zero bytes was asked for where the construction
    // forbids it.  KMAC's output length is encoded into the message it
    // authenticates (SP 800-185 § 4.3), so a zero-length KMAC is a
    // different value from an empty squeeze and not a value at all.
    Sha3EmptyOutput
    // More input was fed to a state that has already produced output.
    // A sponge pads once; after the padding it is squeezing, and
    // absorbing again would give an answer no other implementation
    // computes.
    Sha3AbsorbAfterSqueeze
    // A sponge was asked for with a rate of zero or less.  A rate is
    // how many bytes of the 200-byte state the message touches, and
    // every rate FIPS 202 defines is between 72 and 168.
    Sha3RateNotPositive(rate: Int)

// Private: the FIPS 202 name of the fixed-width digest whose output is
// `want` bytes long.
//
// The four widths are the only `want` this package raises
// `Sha3OutputBufferWrong` with, so the four arms are the whole of the
// production cases.  A refusal a caller built itself may name any
// length at all, and the wildcard answers a phrase rather than
// inventing a width FIPS 202 does not define.
@tier(app)
fn digest_name(want: Int) -> Str
    match want
        28 => "SHA3-224"
        32 => "SHA3-256"
        48 => "SHA3-384"
        64 => "SHA3-512"
        _  => "the digest"

// message renders the refusal as one line of prose, with the numbers
// in it.
//
// `Result<_, Sha3Error>` requires this impl: SPEC § 3.4 admits a
// `Result` error type only if it implements `Error`.
impl Error for Sha3Error
    // Answer the one-line report: what was refused, and with which
    // numbers.
    //
    // ```novo
    // use sha3err
    //
    // fn main() [io]
    //     let e = Sha3OutputBufferWrong(want: 32, got: 16)
    //     println(e.message())
    //     // sha3: the output buffer is 16 bytes and SHA3-256 writes 32
    // ```
    @tier(app)
    fn message(self) -> Str
        match self
            Sha3OutputBufferWrong(want, got) =>
                "sha3: the output buffer is " + str.from_int(got) + " bytes and "
                    + digest_name(want) + " writes " + str.from_int(want)
            Sha3EmptyOutput                  =>
                "sha3: an output of zero bytes was asked for where the construction forbids it"
            Sha3AbsorbAfterSqueeze           =>
                "sha3: more input was fed to a state that has already produced output"
            Sha3RateNotPositive(rate)        =>
                "sha3: a sponge was asked for with a rate of " + str.from_int(rate)
                    + " bytes, and a rate must be positive"

// Whether the refusal is about a length the caller chose.
//
// True for `Sha3OutputBufferWrong`, `Sha3EmptyOutput` and
// `Sha3RateNotPositive`.  A program that sizes its buffers from this
// package's own constants never sees one.
//
// ```novo
// use sha3err
//
// fn main() [io]
//     println("${sha3err.is_length_fault(Sha3EmptyOutput)}")   // true
// ```
pub @tier(app)
fn is_length_fault(e: Sha3Error) -> Bool []
    match e
        Sha3OutputBufferWrong(_, _) => true
        Sha3EmptyOutput             => true
        Sha3AbsorbAfterSqueeze      => false
        Sha3RateNotPositive(_)      => true

// Whether the refusal is about the order two calls were made in.
//
// True for `Sha3AbsorbAfterSqueeze` alone.  It separates a caller that
// sized something wrong from a caller whose state machine is wrong,
// which are different bugs and different fixes.
//
// ```novo
// use sha3err
//
// fn main() [io]
//     println("${sha3err.is_order_fault(Sha3AbsorbAfterSqueeze)}")   // true
// ```
pub @tier(app)
fn is_order_fault(e: Sha3Error) -> Bool []
    match e
        Sha3AbsorbAfterSqueeze      => true
        Sha3OutputBufferWrong(_, _) => false
        Sha3EmptyOutput             => false
        Sha3RateNotPositive(_)      => false

// The refusal as a short stable token, for a log that is grepped
// rather than read: `"output-buffer-wrong"`, `"empty-output"`,
// `"absorb-after-squeeze"`, `"rate-not-positive"`.
//
// ```novo
// use sha3err
//
// fn main() [io]
//     println(sha3err.code(Sha3EmptyOutput))   // empty-output
// ```
pub @tier(app)
fn code(e: Sha3Error) -> Str []
    match e
        Sha3OutputBufferWrong(_, _) => "output-buffer-wrong"
        Sha3EmptyOutput             => "empty-output"
        Sha3AbsorbAfterSqueeze      => "absorb-after-squeeze"
        Sha3RateNotPositive(_)      => "rate-not-positive"
